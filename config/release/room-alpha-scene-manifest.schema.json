{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-twin.local/schemas/room-alpha-scene-manifest.schema.json",
  "title": "Manifest-Driven Room Alpha scene manifest v0.1",
  "type": "object",
  "required": ["schema_version", "manifest_id", "scene_id", "profile_id", "generated_at", "source", "avatar_manifest_id", "avatar_manifest_sha256", "room_geometry_sha256", "room", "constraints", "placements", "candidate_generation", "ranking", "interaction_policy", "unknown_product_fallback", "rejected_candidates"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "manifest_id": {"$ref": "#/$defs/id"},
    "scene_id": {"$ref": "#/$defs/id"},
    "profile_id": {"$ref": "#/$defs/id"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "required": ["workstream", "branch", "commit_sha", "pipeline_version"],
      "properties": {"workstream": {"const": "ROOM_LAB"}, "branch": {"const": "agent/room-lab-commerce-showroom"}, "commit_sha": {"$ref": "#/$defs/commit"}, "pipeline_version": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "avatar_manifest_id": {"$ref": "#/$defs/id"},
    "avatar_manifest_sha256": {"$ref": "#/$defs/hash"},
    "room_geometry_sha256": {"$ref": "#/$defs/hash"},
    "room": {
      "type": "object",
      "required": ["bounds", "surfaces", "openings", "protected_paths"],
      "properties": {
        "bounds": {"$ref": "#/$defs/bounds"},
        "surfaces": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/surface"}},
        "openings": {"type": "array", "items": {"$ref": "#/$defs/opening"}},
        "protected_paths": {"type": "array", "items": {"$ref": "#/$defs/protected_path"}}
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "required": ["hard", "soft"],
      "properties": {
        "hard": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hard_constraint"}},
        "soft": {"type": "array", "items": {"$ref": "#/$defs/soft_preference"}}
      },
      "additionalProperties": false
    },
    "placements": {"type": "array", "items": {"$ref": "#/$defs/placement"}},
    "candidate_generation": {
      "type": "object",
      "required": ["algorithm", "algorithm_version", "seed", "deterministic", "candidates"],
      "properties": {
        "algorithm": {"type": "string", "minLength": 1},
        "algorithm_version": {"type": "string", "minLength": 1},
        "seed": {"type": "integer"},
        "deterministic": {"const": true},
        "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}}
      },
      "additionalProperties": false
    },
    "ranking": {
      "type": "object",
      "required": ["algorithm_version", "deterministic", "tie_break", "ranked_candidate_ids"],
      "properties": {"algorithm_version": {"type": "string", "minLength": 1}, "deterministic": {"const": true}, "tie_break": {"const": "CANDIDATE_ID_ASC"}, "ranked_candidate_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}},
      "additionalProperties": false
    },
    "interaction_policy": {
      "type": "object",
      "required": ["drag", "pickup", "nudge", "rotation"],
      "properties": {"drag": {"$ref": "#/$defs/interaction"}, "pickup": {"$ref": "#/$defs/interaction"}, "nudge": {"$ref": "#/$defs/interaction"}, "rotation": {"$ref": "#/$defs/interaction"}},
      "additionalProperties": false
    },
    "unknown_product_fallback": {"$ref": "#/$defs/fallback"},
    "rejected_candidates": {"type": "array", "items": {"$ref": "#/$defs/rejected"}}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_:-]{2,127}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "vec3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "positive_vec3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "exclusiveMinimum": 0}},
    "bounds": {
      "type": "object", "required": ["min_m", "max_m"],
      "properties": {"min_m": {"$ref": "#/$defs/vec3"}, "max_m": {"$ref": "#/$defs/vec3"}}, "additionalProperties": false
    },
    "surface": {
      "type": "object", "required": ["surface_id", "type", "bounds"],
      "properties": {"surface_id": {"$ref": "#/$defs/id"}, "type": {"enum": ["FLOOR", "WALL", "CEILING"]}, "bounds": {"$ref": "#/$defs/bounds"}}, "additionalProperties": false
    },
    "opening": {
      "type": "object", "required": ["opening_id", "surface_id", "clearance_bounds"],
      "properties": {"opening_id": {"$ref": "#/$defs/id"}, "surface_id": {"$ref": "#/$defs/id"}, "clearance_bounds": {"$ref": "#/$defs/bounds"}}, "additionalProperties": false
    },
    "protected_path": {
      "type": "object", "required": ["path_id", "bounds", "minimum_width_m"],
      "properties": {"path_id": {"$ref": "#/$defs/id"}, "bounds": {"$ref": "#/$defs/bounds"}, "minimum_width_m": {"type": "number", "minimum": 0.8}}, "additionalProperties": false
    },
    "hard_constraint": {
      "type": "object", "required": ["constraint_id", "type"],
      "properties": {"constraint_id": {"$ref": "#/$defs/id"}, "type": {"type": "string", "minLength": 1}}, "additionalProperties": false
    },
    "soft_preference": {
      "type": "object", "required": ["preference_id", "type", "weight"],
      "properties": {"preference_id": {"$ref": "#/$defs/id"}, "type": {"type": "string", "minLength": 1}, "weight": {"type": "number", "minimum": 0, "maximum": 1}}, "additionalProperties": false
    },
    "transform": {
      "type": "object", "required": ["position_m", "rotation_deg"],
      "properties": {"position_m": {"$ref": "#/$defs/vec3"}, "rotation_deg": {"$ref": "#/$defs/vec3"}}, "additionalProperties": false
    },
    "floor_anchor": {
      "type": "object", "required": ["surface_id", "world_point_m"],
      "properties": {"surface_id": {"$ref": "#/$defs/id"}, "world_point_m": {"$ref": "#/$defs/vec3"}}, "additionalProperties": false
    },
    "envelope": {
      "type": "object", "required": ["width", "height", "depth"],
      "properties": {"width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}, "depth": {"type": "number", "exclusiveMinimum": 0}}, "additionalProperties": false
    },
    "clearance": {
      "type": "object", "required": ["front", "back", "left", "right"],
      "properties": {"front": {"type": "number", "minimum": 0}, "back": {"type": "number", "minimum": 0}, "left": {"type": "number", "minimum": 0}, "right": {"type": "number", "minimum": 0}}, "additionalProperties": false
    },
    "placement": {
      "type": "object",
      "required": ["placement_id", "scene_id", "profile_id", "asset_id", "transform", "floor_anchor", "collision_envelope_m", "functional_clearance_m", "source_candidate_id"],
      "properties": {"placement_id": {"$ref": "#/$defs/id"}, "scene_id": {"$ref": "#/$defs/id"}, "profile_id": {"$ref": "#/$defs/id"}, "asset_id": {"$ref": "#/$defs/id"}, "transform": {"$ref": "#/$defs/transform"}, "floor_anchor": {"$ref": "#/$defs/floor_anchor"}, "collision_envelope_m": {"$ref": "#/$defs/envelope"}, "functional_clearance_m": {"$ref": "#/$defs/clearance"}, "source_candidate_id": {"$ref": "#/$defs/id"}},
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["candidate_id", "placement_id", "transform", "hard_constraints_passed", "hard_failure_reasons", "soft_score"],
      "properties": {"candidate_id": {"$ref": "#/$defs/id"}, "placement_id": {"$ref": "#/$defs/id"}, "transform": {"$ref": "#/$defs/transform"}, "hard_constraints_passed": {"type": "boolean"}, "hard_failure_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}}, "soft_score": {"type": "number"}},
      "additionalProperties": false
    },
    "interaction": {
      "type": "object", "required": ["boundary_enforced", "collision_enforced"],
      "properties": {"boundary_enforced": {"const": true}, "collision_enforced": {"const": true}}, "additionalProperties": false
    },
    "fallback": {
      "type": "object", "required": ["policy", "dimensions_m", "clearance_m", "public_allowed"],
      "properties": {"policy": {"enum": ["REJECT", "CONSERVATIVE_BOX"]}, "dimensions_m": {"$ref": "#/$defs/positive_vec3"}, "clearance_m": {"type": "number", "minimum": 0.3}, "public_allowed": {"const": false}}, "additionalProperties": false
    },
    "rejected": {
      "type": "object", "required": ["candidate_id", "reasons"],
      "properties": {"candidate_id": {"$ref": "#/$defs/id"}, "reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false
    }
  }
}
