{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-twin.local/schemas/media/cost-record.schema.json",
  "title": "Media cost record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cost_id", "job_id", "provider", "currency", "pricing_observed_at", "pricing_source", "unit", "quantity", "estimate", "actual", "experiment_cap", "approval_required_above", "status"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "cost_id": {"type": "string"},
    "job_id": {"type": "string"},
    "provider": {"enum": ["LOCAL", "REPLICATE"]},
    "currency": {"const": "USD"},
    "pricing_observed_at": {"type": "string", "format": "date"},
    "pricing_source": {"type": "string", "minLength": 1},
    "unit": {"type": "string", "minLength": 1},
    "quantity": {"type": "number", "exclusiveMinimum": 0},
    "estimate": {"type": "number", "minimum": 0},
    "actual": {"type": "number", "minimum": 0},
    "experiment_cap": {"type": "number", "minimum": 0},
    "approval_required_above": {"type": "number", "minimum": 0},
    "status": {"enum": ["ESTIMATE", "INCURRED", "RECONCILED", "CANCELLED"]}
  }
}
