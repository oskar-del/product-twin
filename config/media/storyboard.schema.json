{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-twin.local/schemas/media/storyboard.schema.json",
  "title": "Room media storyboard",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "storyboard_id", "scene_id", "scene_sha256", "camera_path_ref", "camera_pack_sha256", "duration_s", "frame_rate_fps", "frame_count", "fidelity_class", "disclosure_ref", "audio", "beats", "edit_policy", "animation_policy", "approval_state"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "storyboard_id": {"type": "string"},
    "scene_id": {"type": "string"},
    "scene_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "camera_path_ref": {"type": "string"},
    "camera_pack_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "duration_s": {"type": "number", "minimum": 15, "maximum": 30},
    "frame_rate_fps": {"type": "integer", "minimum": 1},
    "frame_count": {"type": "integer", "minimum": 1},
    "fidelity_class": {"type": "string"},
    "disclosure_ref": {"type": "string"},
    "audio": {
      "type": "object", "additionalProperties": false, "required": ["included", "reason"],
      "properties": {"included": {"type": "boolean"}, "reason": {"type": "string"}}
    },
    "beats": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["start_s", "end_s", "name", "visual_intent", "truth_check"],
        "properties": {"start_s": {"type": "number", "minimum": 0}, "end_s": {"type": "number", "minimum": 0}, "name": {"type": "string"}, "visual_intent": {"type": "string"}, "truth_check": {"type": "string"}}
      }
    },
    "edit_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["cuts_allowed", "speed_ramps_allowed", "generative_insert_shots_allowed", "text_inside_clean_frames", "disclosure_carried_in_manifest_and_caption"],
      "properties": {"cuts_allowed": {"const": false}, "speed_ramps_allowed": {"const": false}, "generative_insert_shots_allowed": {"const": false}, "text_inside_clean_frames": {"const": false}, "disclosure_carried_in_manifest_and_caption": {"const": true}}
    },
    "animation_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["placement_animation", "light_animation", "material_animation", "camera_animation_only"],
      "properties": {"placement_animation": {"type": "array", "maxItems": 0}, "light_animation": {"type": "array", "maxItems": 0}, "material_animation": {"type": "array", "maxItems": 0}, "camera_animation_only": {"const": true}}
    },
    "approval_state": {"type": "string"}
  }
}
