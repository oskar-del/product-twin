{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-twin.local/schemas/media/generative-job.schema.json",
  "title": "Generative media job",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "scene_id", "provider", "model", "input_refs", "prompt", "negative_constraints", "seed", "settings", "mutation_policy", "rights_ref", "cost_ref", "credential_state", "provider_prediction_id", "status", "blocked_reasons", "output_refs"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "job_id": {"type": "string"},
    "scene_id": {"type": "string"},
    "provider": {"const": "REPLICATE"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "version", "version_capture_policy", "pricing_source"],
      "properties": {
        "identifier": {"type": "string"},
        "version": {"type": ["string", "null"]},
        "version_capture_policy": {"type": "string"},
        "pricing_source": {"type": "string", "format": "uri"}
      }
    },
    "input_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "prompt": {"type": "string", "minLength": 1},
    "negative_constraints": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "seed": {"type": "integer"},
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_s", "resolution", "quality", "start_end_frame_conditioning"],
      "properties": {
        "duration_s": {"type": "number", "exclusiveMinimum": 0},
        "resolution": {"type": "string"},
        "quality": {"type": "string"},
        "start_end_frame_conditioning": {"type": "boolean"}
      }
    },
    "mutation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["camera_motion_only", "verification_authority", "must_compare_against_direct_3d_control"],
      "properties": {
        "camera_motion_only": {"const": true},
        "verification_authority": {"const": false},
        "must_compare_against_direct_3d_control": {"const": true}
      }
    },
    "rights_ref": {"type": "string"},
    "cost_ref": {"type": "string"},
    "credential_state": {"enum": ["CONFIGURED", "NOT_CONFIGURED", "UNKNOWN"]},
    "provider_prediction_id": {"type": ["string", "null"]},
    "status": {"enum": ["PLANNED", "BLOCKED", "READY", "RUNNING", "SUCCEEDED", "FAILED", "REJECTED"]},
    "blocked_reasons": {"type": "array", "items": {"type": "string"}},
    "output_refs": {"type": "array", "items": {"type": "string"}}
  }
}
