{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-twin.local/schemas/site/evidence-source-manifest.schema.json",
  "title": "Site evidence source manifest",
  "type": "object",
  "required": ["schema_version", "source_set_id", "storage_policy", "documents", "limitations"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "0.1"},
    "source_set_id": {"type": "string", "pattern": "^SRCSET_[A-Z0-9_]+$"},
    "storage_policy": {"type": "string", "minLength": 3},
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "document_id",
          "title",
          "original_filename",
          "pdf_pages",
          "sha256",
          "document_date",
          "reviewed_at",
          "underlying_official_artifacts_attached"
        ],
        "additionalProperties": false,
        "properties": {
          "document_id": {"type": "string", "pattern": "^DOC_[A-Z0-9_]+$"},
          "title": {"type": "string", "minLength": 3},
          "original_filename": {"type": "string", "pattern": "^[^/\\\\]+\\.pdf$"},
          "pdf_pages": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "document_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "reviewed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "underlying_official_artifacts_attached": {"const": false}
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    }
  }
}
