{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-twin.local/schemas/spatial/existing-condition-twin-v1.schema.json",
  "title": "Existing Condition Twin v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "entity_type", "existing_condition_twin_id", "version", "lifecycle_state", "unit_twin_id", "observation_date", "frame", "condition_geometry", "element_observations", "space_twin_ids", "munin_reference_ids", "external_evidence_refs", "blockers"],
  "properties": {
    "manifest_version": {"const": "existing-condition-twin/v1"},
    "entity_type": {"const": "ExistingConditionTwin"},
    "existing_condition_twin_id": {"type": "string", "pattern": "^ECOND_[A-Z0-9_]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "lifecycle_state": {"enum": ["UNBOUND", "REFERENCE_ONLY", "SPATIAL_BASIS", "VERIFIED"]},
    "unit_twin_id": {"type": "string", "pattern": "^UNIT_[A-Z0-9_]+$"},
    "observation_date": {"type": ["string", "null"], "format": "date"},
    "frame": {"$ref": "./plot-to-project-defs-v1.schema.json#/$defs/frame"},
    "condition_geometry": {"$ref": "./plot-to-project-defs-v1.schema.json#/$defs/geometryBinding"},
    "element_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observation_id", "spatial_element_ref", "condition_code", "geometry_ref", "evidence_state", "evidence_refs"],
        "properties": {
          "observation_id": {"type": "string", "minLength": 1},
          "spatial_element_ref": {"type": "string", "minLength": 1},
          "condition_code": {"type": "string", "minLength": 1},
          "geometry_ref": {"type": ["string", "null"]},
          "evidence_state": {"$ref": "./plot-to-project-defs-v1.schema.json#/$defs/evidenceState"},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "space_twin_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "munin_reference_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "external_evidence_refs": {"type": "array", "items": {"$ref": "./plot-to-project-defs-v1.schema.json#/$defs/externalEvidenceBinding"}},
    "blockers": {"$ref": "./plot-to-project-defs-v1.schema.json#/$defs/blockers"}
  }
}
