{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-twin.local/schemas/spatial/svartinge-neighbourhood-scene-v0.2.schema.json",
  "title": "Svartinge Neighbourhood Scene Export v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["scene_version", "entity_type", "scene_id", "generated_at", "subject", "coordinate_system", "source_bindings", "evidence_classes", "measurements", "legal_claim_policy", "navigation", "elements", "studies", "prototype", "project_status"],
  "properties": {
    "scene_version": {"const": "svartinge-neighbourhood-scene/v0.2"},
    "entity_type": {"const": "NeighbourhoodSceneExport"},
    "scene_id": {"const": "SCENE_SE_NORRKOPING_SVARTINGE_54_28_CONCEPT_V02"},
    "generated_at": {"type": "string", "format": "date-time"},
    "subject": {"type": "object", "additionalProperties": false, "required": ["working_property_identity", "address", "municipality", "identity_evidence_class", "identity_scope"], "properties": {"working_property_identity": {"const": "SVÄRTINGE 54:28"}, "address": {"type": "string"}, "municipality": {"const": "Norrköping"}, "identity_evidence_class": {"const": "AUTHORITATIVE"}, "identity_scope": {"const": "MUNICIPAL_ADDRESS_TO_PROPERTY_OBSERVATION_NOT_PROPERTY_REGISTER"}}},
    "coordinate_system": {"type": "object", "additionalProperties": false, "required": ["frame", "origin_wgs84", "horizontal_reference", "vertical_reference", "linear_units", "evidence_class", "limitations"], "properties": {"frame": {"const": "LOCAL_ENU"}, "origin_wgs84": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}, "horizontal_reference": {"type": "string"}, "vertical_reference": {"const": "LOCAL_RELATIVE_UNCALIBRATED"}, "linear_units": {"const": "metre"}, "evidence_class": {"const": "AUTHORITATIVE"}, "limitations": {"$ref": "#/$defs/stringArray"}}},
    "source_bindings": {"type": "array", "minItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "role"], "properties": {"path": {"type": "string"}, "sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"const": "RUNTIME_ONLY_NOT_COMMITTED"}]}, "role": {"type": "string"}}}},
    "evidence_classes": {"const": ["AUTHORITATIVE", "INDICATIVE", "DERIVED", "REPORTED_UNVERIFIED", "CONCEPT"]},
    "measurements": {"type": "object", "additionalProperties": false, "required": ["municipal_map_area_m2", "listing_area_m2", "derived_trace_area_m2"], "properties": {"municipal_map_area_m2": {"$ref": "#/$defs/measurement"}, "listing_area_m2": {"$ref": "#/$defs/measurement"}, "derived_trace_area_m2": {"$ref": "#/$defs/measurement"}}},
    "legal_claim_policy": {"type": "object", "additionalProperties": false, "required": ["visualisation_allowed", "concept_design_allowed", "sun_view_navigation_allowed", "blocked_claims", "rule"], "properties": {"visualisation_allowed": {"const": true}, "concept_design_allowed": {"const": true}, "sun_view_navigation_allowed": {"const": true}, "blocked_claims": {"type": "array", "minItems": 7, "items": {"type": "string"}}, "rule": {"type": "string"}}},
    "navigation": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/navigationStep"}},
    "elements": {"type": "array", "minItems": 30, "items": {"$ref": "#/$defs/element"}},
    "studies": {"type": "object", "additionalProperties": false, "required": ["solar", "views"], "properties": {"solar": {"$ref": "#/$defs/study"}, "views": {"$ref": "#/$defs/study"}}},
    "prototype": {"type": "object", "additionalProperties": false, "required": ["viewer_path", "requires_http_server", "recommended_command", "default_step"], "properties": {"viewer_path": {"const": "prototype/svartinge-neighbourhood/index.html"}, "requires_http_server": {"const": true}, "recommended_command": {"const": "npm run site:sweden:svartinge:prototype:serve"}, "default_step": {"const": "NEIGHBOURHOOD_VIEW"}}},
    "project_status": {"type": "object", "additionalProperties": false, "required": ["design_scenario", "selected_house_profile", "source_project_status"], "properties": {"design_scenario": {"const": "CONCEPT_VISUALISATION_ACTIVE_LEGAL_GATES_OPEN"}, "selected_house_profile": {"type": "null"}, "source_project_status": {"type": ["string", "null"]}}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stringArray": {"type": "array", "items": {"type": "string"}},
    "evidenceClass": {"enum": ["AUTHORITATIVE", "INDICATIVE", "DERIVED", "REPORTED_UNVERIFIED", "CONCEPT"]},
    "measurement": {"type": "object", "additionalProperties": false, "required": ["value", "evidence_class"], "properties": {"value": {"type": "number"}, "evidence_class": {"$ref": "#/$defs/evidenceClass"}, "source_ref": {"type": "string"}, "method": {"type": "string"}}},
    "navigationStep": {"type": "object", "additionalProperties": false, "required": ["id", "label", "camera", "target", "visible_groups", "cutaway"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "camera": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}, "target": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}, "visible_groups": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "cutaway": {"type": "boolean"}}},
    "element": {"type": "object", "additionalProperties": false, "required": ["id", "type", "label", "evidence_class", "geometry", "source_refs", "limitations"], "properties": {"id": {"type": "string", "minLength": 1}, "type": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}, "evidence_class": {"$ref": "#/$defs/evidenceClass"}, "geometry": {"type": "object"}, "source_refs": {"$ref": "#/$defs/stringArray"}, "limitations": {"$ref": "#/$defs/stringArray"}}},
    "study": {"type": "object", "required": ["evidence_class", "limitations"], "properties": {"evidence_class": {"$ref": "#/$defs/evidenceClass"}, "limitations": {"$ref": "#/$defs/stringArray"}}}
  }
}
