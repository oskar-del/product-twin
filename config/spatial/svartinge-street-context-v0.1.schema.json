{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-twin.local/schemas/svartinge-street-context-v0.1.schema.json",
  "title": "Svärtinge Street Context v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entity_type", "subject", "focus", "observations", "character", "rendering_policy"],
  "properties": {
    "schema_version": {"const": "svartinge-street-context/v0.1"},
    "entity_type": {"const": "StreetContextObservationSet"},
    "subject": {"const": "SVÄRTINGE 54:28"},
    "focus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "detail_radius_m", "wider_context_policy", "geometry_policy"],
      "properties": {
        "name": {"type": "string"},
        "detail_radius_m": {"const": 80},
        "wider_context_policy": {"const": "LIGHTWEIGHT_CONTEXT_ONLY"},
        "geometry_policy": {"const": "PRODUCT_TWIN_GEOMETRY_ONLY_NO_PROVIDER_TRACING"}
      }
    },
    "observations": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observation_id", "provider_id", "evidence_role", "relationship_to_subject", "source_url", "observed_label", "imagery_date", "observed_at", "artifact_receipt", "content_persisted", "geometry_extraction_allowed", "exact_plot_frontage_confirmed", "attribution", "limitations"],
        "properties": {
          "observation_id": {"type": "string"},
          "provider_id": {"enum": ["NORRKOPING_ORTHOPHOTO", "GOOGLE_STREET_VIEW", "HEMNET_LISTING"]},
          "evidence_role": {"enum": ["AUTHORITATIVE_CONTEXT_CANDIDATE", "REFERENCE_ONLY", "LISTED_REFERENCE"]},
          "relationship_to_subject": {"enum": ["EXACT_RECORDED_MUNICIPAL_POINT_TILE", "NEARBY_SAME_STREET_NOT_EXACT_PLOT_FRONTAGE", "EXACT_ADDRESS_LISTING_GALLERY_NOT_SURVEY"]},
          "source_url": {"type": "string", "pattern": "^https://"},
          "observed_label": {"type": "string"},
          "imagery_date": {"type": ["string", "null"]},
          "observed_at": {"type": "string"},
          "artifact_receipt": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["request_method", "canonical_request", "response_status", "content_type", "byte_count", "sha256", "crs", "bounds", "cache_tile_index", "cache_last_modified", "cache_last_modified_is_acquisition_date"],
                "properties": {
                  "request_method": {"const": "GET"},
                  "canonical_request": {"type": "string", "pattern": "^https://"},
                  "response_status": {"const": 200},
                  "content_type": {"const": "image/png"},
                  "byte_count": {"const": 123575},
                  "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                  "crs": {"const": "EPSG:3010"},
                  "bounds": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
                  "cache_tile_index": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer"}},
                  "cache_last_modified": {"type": "string"},
                  "cache_last_modified_is_acquisition_date": {"const": false}
                }
              }
            ]
          },
          "content_persisted": {"const": false},
          "geometry_extraction_allowed": {"const": false},
          "exact_plot_frontage_confirmed": {"const": false},
          "attribution": {"type": "string"},
          "limitations": {"type": "array", "minItems": 2, "items": {"type": "string"}}
        }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["road", "terrain_and_view", "vegetation", "utilities", "buildings", "frontage", "exact_plot_visual"],
      "properties": {
        "road": {"$ref": "#/$defs/characterItem"},
        "terrain_and_view": {"$ref": "#/$defs/characterItem"},
        "vegetation": {"$ref": "#/$defs/characterItem"},
        "utilities": {"$ref": "#/$defs/characterItem"},
        "buildings": {"$ref": "#/$defs/characterItem"},
        "frontage": {"$ref": "#/$defs/characterItem"},
        "exact_plot_visual": {"$ref": "#/$defs/characterItem"}
      }
    },
    "rendering_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["street_room_high_detail", "exact_provider_geometry", "provider_pixels_in_repository", "legal_or_survey_promotion", "live_attribution_required", "street_view_live_reference_only", "listing_pixels_in_repository"],
      "properties": {
        "street_room_high_detail": {"const": true},
        "exact_provider_geometry": {"const": false},
        "provider_pixels_in_repository": {"const": false},
        "legal_or_survey_promotion": {"const": false},
        "live_attribution_required": {"const": true},
        "street_view_live_reference_only": {"const": true},
        "listing_pixels_in_repository": {"const": false}
      }
    }
  },
  "$defs": {
    "characterItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "observed", "render_use"],
      "properties": {
        "state": {"enum": ["REFERENCE_ONLY_NEARBY", "LISTED_REFERENCE"]},
        "observed": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "render_use": {"enum": ["MATERIAL_AND_CHARACTER_ONLY", "ATMOSPHERE_AND_VIEW_CORRIDOR_ONLY", "SPECIES_MIX_AND_DENSITY_ONLY", "ILLUSTRATIVE_STREET_CHARACTER_ONLY", "PALETTE_AND_ARCHETYPES_ONLY", "EXACT_LISTING_CHARACTER_ONLY"]}
      }
    }
  }
}
