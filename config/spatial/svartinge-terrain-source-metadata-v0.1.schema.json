{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-twin.local/schemas/spatial/svartinge-terrain-source-metadata-v0.1.schema.json",
  "title": "Svartinge terrain source metadata v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entity_type", "subject", "source_item", "public_metadata_receipts", "locator_projection", "source_at_plot", "raster_access", "municipal_alternative", "terrain_gate"],
  "properties": {
    "schema_version": {"const": "svartinge-terrain-source-metadata/v0.1"},
    "entity_type": {"const": "TerrainSourceMetadataReceiptSet"},
    "subject": {"const": "SVÄRTINGE 54:28"},
    "source_item": {"type": "object", "additionalProperties": false, "required": ["authority", "collection", "item_id", "item_url", "data_asset_url", "data_asset_size_bytes", "data_asset_multihash", "projected_bbox", "wgs84_bbox", "compound_crs", "horizontal_crs", "vertical_datum", "grid_resolution_m", "nodata", "grid_shape", "updated_at", "data_modified_at"], "properties": {"authority": {"const": "Lantmäteriet"}, "collection": {"const": "dtm-cog"}, "item_id": {"const": "650_55"}, "item_url": {"type": "string"}, "data_asset_url": {"type": "string"}, "data_asset_size_bytes": {"type": "integer"}, "data_asset_multihash": {"type": "string"}, "projected_bbox": {"$ref": "#/$defs/numberArray"}, "wgs84_bbox": {"$ref": "#/$defs/numberArray"}, "compound_crs": {"const": "EPSG:5845"}, "horizontal_crs": {"const": "EPSG:3006"}, "vertical_datum": {"const": "RH2000"}, "grid_resolution_m": {"const": 1}, "nodata": {"const": -9999}, "grid_shape": {"$ref": "#/$defs/numberArray"}, "updated_at": {"type": "string"}, "data_modified_at": {"type": "string"}}},
    "public_metadata_receipts": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/receipt"}},
    "locator_projection": {"type": "object", "additionalProperties": false, "required": ["source_coordinate_wgs84", "projected_coordinate_epsg3006", "method", "control_example_input_lat_lon", "control_example_expected_northing_easting", "control_error_m", "scope"], "properties": {"source_coordinate_wgs84": {"$ref": "#/$defs/numberArray"}, "projected_coordinate_epsg3006": {"$ref": "#/$defs/numberArray"}, "method": {"type": "string"}, "control_example_input_lat_lon": {"$ref": "#/$defs/numberArray"}, "control_example_expected_northing_easting": {"$ref": "#/$defs/numberArray"}, "control_error_m": {"type": "number"}, "scope": {"type": "string"}}},
    "source_at_plot": {"type": "object", "additionalProperties": false, "required": ["provenance_feature_id", "measurement_date", "measurement_method", "producer", "reported_horizontal_uncertainty_m", "reported_vertical_uncertainty_m", "selection_method", "verification_state"], "properties": {"provenance_feature_id": {"const": "0"}, "measurement_date": {"const": "2020-11-20"}, "measurement_method": {"const": "Luftburen laserskanning"}, "producer": {"const": "Lantmateriet"}, "reported_horizontal_uncertainty_m": {"const": 0.3}, "reported_vertical_uncertainty_m": {"const": 0.1}, "selection_method": {"type": "string"}, "verification_state": {"const": "OFFICIAL_METADATA_VERIFIED_RASTER_NOT_ACQUIRED"}}},
    "raster_access": {"type": "object", "additionalProperties": false, "required": ["state", "last_checked_at", "http_status_without_credentials", "raster_bytes_acquired", "terrain_values_available", "runtime_credential_persisted"], "properties": {"state": {"const": "KEY_REQUIRED"}, "last_checked_at": {"type": "string"}, "http_status_without_credentials": {"const": 401}, "raster_bytes_acquired": {"const": false}, "terrain_values_available": {"const": false}, "runtime_credential_persisted": {"const": false}}},
    "municipal_alternative": {"type": "object", "additionalProperties": false, "required": ["authority", "product", "document_url", "document_date", "reported_products", "reported_vertical_accuracy_m", "exact_plot_coverage", "minimum_fee_sek", "state"], "properties": {"authority": {"const": "Norrköpings kommun"}, "product": {"const": "Laserdata, terrängmodell"}, "document_url": {"type": "string"}, "document_date": {"const": "2026-04-13"}, "reported_products": {"type": "array", "minItems": 2, "items": {"type": "string"}}, "reported_vertical_accuracy_m": {"const": 0.05}, "exact_plot_coverage": {"const": "UNKNOWN_REQUIRES_MUNICIPAL_CONFIRMATION"}, "minimum_fee_sek": {"const": 500}, "state": {"const": "DOCUMENTED_NOT_CONNECTED"}}},
    "terrain_gate": {"type": "object", "additionalProperties": false, "required": ["gate_id", "status", "reason", "forbidden_outputs_until_closed"], "properties": {"gate_id": {"const": "GATE_SE_TERRAIN"}, "status": {"const": "OPEN"}, "reason": {"type": "string"}, "forbidden_outputs_until_closed": {"type": "array", "minItems": 5, "items": {"type": "string"}}}
  },
  "$defs": {
    "numberArray": {"type": "array", "minItems": 2, "items": {"type": "number"}},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "receipt": {"type": "object", "additionalProperties": false, "required": ["receipt_id", "source_url", "runtime_locator", "retrieved_at", "byte_count", "sha256", "content_persisted_in_repository"], "properties": {"receipt_id": {"type": "string"}, "source_url": {"type": "string"}, "runtime_locator": {"type": "string"}, "retrieved_at": {"type": "string"}, "byte_count": {"type": "integer"}, "sha256": {"$ref": "#/$defs/sha256"}, "content_persisted_in_repository": {"const": false}}}
  }
}
}
