{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-twin.local/schemas/svartinge-context-providers-v0.1.schema.json",
  "title": "Svärtinge Context Provider Interface v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entity_type", "subject", "policy", "providers"],
  "properties": {
    "schema_version": {"const": "svartinge-context-providers/v0.1"},
    "entity_type": {"const": "SpatialContextProviderRegistry"},
    "subject": {"const": "SVÄRTINGE 54:28"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["no_committed_credentials", "no_provider_content_reclassified", "restricted_tiles_live_only", "attribution_required"],
      "properties": {
        "no_committed_credentials": {"const": true},
        "no_provider_content_reclassified": {"const": true},
        "restricted_tiles_live_only": {"const": true},
        "attribution_required": {"const": true}
      }
    },
    "providers": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider_id", "label", "capability", "state", "evidence_role", "delivery_mode", "credential_configured", "source_url", "limitations"],
        "properties": {
          "provider_id": {"type": "string", "minLength": 3},
          "label": {"type": "string", "minLength": 3},
          "capability": {"type": "string", "minLength": 3},
          "state": {"enum": ["CONNECTED", "EXECUTABLE_NOT_TESTED", "DOCUMENTED_NOT_CONNECTED", "KEY_REQUIRED", "RESEARCH_ONLY"]},
          "evidence_role": {"enum": ["AUTHORITATIVE_CONTEXT_CANDIDATE", "LIVE_VISUAL_CONTEXT", "REFERENCE_ONLY", "LOCAL_VISUALISATION"]},
          "delivery_mode": {"enum": ["LOCAL_PROCEDURAL", "LIVE_TILES", "LIVE_EMBED", "DOWNLOAD_OR_WMS", "MUNICIPAL_ORDER"]},
          "credential_configured": {"type": "boolean"},
          "source_url": {"type": "string", "pattern": "^https://"},
          "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}
        }
      }
    }
  }
}
