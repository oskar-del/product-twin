{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-twin.local/schemas/spatial/twin-scene-v0.1.schema.json",
  "title": "Twin Scene v0.1",
  "description": "Site-agnostic scene contract consumed by twin-engine. Deliberately a structural SUPERSET: a per-site profile (for example svartinge-neighbourhood-scene/v0.2) pins its own constants and sets additionalProperties:false on top of this. Any document valid against a site profile must also be valid here.",
  "type": "object",
  "required": ["scene_version", "entity_type", "scene_id", "generated_at", "subject", "coordinate_system", "source_bindings", "evidence_classes", "legal_claim_policy", "navigation", "elements"],
  "properties": {
    "scene_version": {"type": "string", "pattern": "^[a-z0-9-]+/v[0-9]+\\.[0-9]+$"},
    "entity_type": {"type": "string", "pattern": "SceneExport$"},
    "scene_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "subject": {
      "type": "object",
      "required": ["identity_evidence_class", "identity_scope"],
      "properties": {
        "identity_evidence_class": {"$ref": "#/$defs/evidenceClass"},
        "identity_scope": {"type": "string", "minLength": 1}
      }
    },
    "coordinate_system": {
      "type": "object",
      "required": ["frame", "axes", "origin_wgs84", "vertical_reference", "linear_units", "evidence_class", "limitations"],
      "properties": {
        "frame": {"const": "LOCAL_ENU"},
        "axes": {
          "type": "object",
          "required": ["x", "y", "z"],
          "properties": {"x": {"const": "EAST"}, "y": {"const": "UP"}, "z": {"const": "NORTH"}}
        },
        "origin_wgs84": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
        "linear_units": {"const": "metre"},
        "vertical_reference": {"type": "string", "minLength": 1},
        "evidence_class": {"$ref": "#/$defs/evidenceClass"},
        "limitations": {"$ref": "#/$defs/stringArray"}
      }
    },
    "source_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "role"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"anyOf": [{"type": "string", "pattern": "^[a-f0-9]{64}$"}, {"const": "RUNTIME_ONLY_NOT_COMMITTED"}]},
          "role": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence_classes": {"const": ["AUTHORITATIVE", "INDICATIVE", "DERIVED", "REPORTED_UNVERIFIED", "CONCEPT"]},
    "legal_claim_policy": {
      "type": "object",
      "required": ["blocked_claims", "rule"],
      "properties": {
        "blocked_claims": {"$ref": "#/$defs/stringArray"},
        "rule": {"type": "string", "minLength": 1}
      }
    },
    "navigation": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/navigationStage"}},
    "elements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/element"}},
    "studies": {"type": "object"},
    "presentation": {
      "type": "object",
      "properties": {
        "profiles": {"type": "array", "minItems": 1, "items": {"enum": ["INTELLIGENCE", "REALISTIC", "COMPARE", "SYSTEMS"]}},
        "default_profile": {"enum": ["INTELLIGENCE", "REALISTIC", "COMPARE", "SYSTEMS"]},
        "default_stage": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "stringArray": {"type": "array", "items": {"type": "string"}},
    "evidenceClass": {"enum": ["AUTHORITATIVE", "INDICATIVE", "DERIVED", "REPORTED_UNVERIFIED", "CONCEPT"]},
    "vec3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "navigationStage": {
      "type": "object",
      "required": ["id", "label", "camera", "target", "visible_groups", "cutaway"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "camera": {"$ref": "#/$defs/vec3"},
        "target": {"$ref": "#/$defs/vec3"},
        "visible_groups": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "cutaway": {"type": "boolean"},
        "labels": {"type": "boolean"},
        "on_enter_open_element": {"type": ["string", "null"]},
        "live_context_view": {
          "type": "object",
          "required": ["center_wgs84", "zoom", "pitch", "bearing", "synchronization", "evidence_effect"],
          "properties": {
            "center_wgs84": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
            "zoom": {"type": "number"},
            "pitch": {"type": "number", "minimum": 0, "maximum": 85},
            "bearing": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
            "synchronization": {"const": "LOCAL_EAST_UP_NORTH_STAGE_REFERENCE"},
            "evidence_effect": {"const": "NONE"}
          }
        }
      }
    },
    "element": {
      "type": "object",
      "required": ["id", "type", "label", "evidence_class", "geometry", "source_refs", "limitations"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "evidence_class": {"$ref": "#/$defs/evidenceClass"},
        "geometry": {
          "type": "object",
          "required": ["primitive"],
          "properties": {
            "primitive": {"enum": ["GRID_SURFACE", "EXTRUDED_POLYGON", "POLYLINE_RIBBON", "BOX", "ROOM_VOLUME", "MARKER", "DIAGRAMMATIC_MARKER", "DIRECTION_CONE", "SOLAR_ARC"]}
          }
        },
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "limitations": {"$ref": "#/$defs/stringArray"}
      }
    }
  }
}
