{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-twin.local/schemas/spatial/plot-to-project-defs-v1.schema.json",
  "title": "Plot-to-Project Spatial Contract shared definitions v1",
  "$defs": {
    "evidenceState": {
      "enum": ["RECORDED", "LISTED", "INFERRED", "FORECAST"]
    },
    "immutableTwinRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "path", "content_sha256", "binding_state"],
      "properties": {
        "id": {"type": "string", "minLength": 3},
        "version": {"type": ["string", "null"]},
        "path": {"type": ["string", "null"]},
        "content_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "binding_state": {"enum": ["UNBOUND", "BOUND"]}
      },
      "allOf": [
        {
          "if": {"properties": {"binding_state": {"const": "UNBOUND"}}},
          "then": {
            "properties": {
              "version": {"type": "null"},
              "path": {"type": "null"},
              "content_sha256": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"binding_state": {"const": "BOUND"}}},
          "then": {
            "properties": {
              "version": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        }
      ]
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_id", "parent_frame_id", "crs", "linear_units", "transform_to_parent", "evidence_state", "evidence_refs"],
      "properties": {
        "frame_id": {"type": "string", "minLength": 1},
        "parent_frame_id": {"type": ["string", "null"]},
        "crs": {"type": ["string", "null"]},
        "linear_units": {"const": "m"},
        "transform_to_parent": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["translation_m", "rotation_quaternion_xyzw", "scale_xyz"],
              "properties": {
                "translation_m": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false},
                "rotation_quaternion_xyzw": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false},
                "scale_xyz": {"const": [1, 1, 1]}
              }
            }
          ]
        },
        "evidence_state": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/evidenceState"}]},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "geometryBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "geometry_kind", "uri", "content_sha256", "crs", "linear_units", "bounds", "evidence_state", "evidence_refs"],
      "properties": {
        "status": {"enum": ["ABSENT", "AVAILABLE"]},
        "geometry_kind": {"type": "string", "minLength": 1},
        "uri": {"type": ["string", "null"]},
        "content_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "crs": {"type": ["string", "null"]},
        "linear_units": {"const": "m"},
        "bounds": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["min", "max"],
              "properties": {
                "min": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false},
                "max": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false}
              }
            }
          ]
        },
        "evidence_state": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/evidenceState"}]},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "externalEvidenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id", "fact_domain", "munin_reference_id", "spatial_target_ref", "applicability", "method"],
      "properties": {
        "binding_id": {"type": "string", "minLength": 1},
        "fact_domain": {
          "enum": [
            "PROPERTY_IDENTITY",
            "BUILDING_IDENTITY",
            "UNIT_IDENTITY",
            "BRF_IDENTITY",
            "HISTORIC_SALES",
            "CURRENT_LISTING",
            "COMPARABLE_SET",
            "MARKET_VALUE",
            "COST",
            "OWNERSHIP"
          ]
        },
        "munin_reference_id": {"type": "string", "minLength": 1},
        "spatial_target_ref": {"type": "string", "minLength": 1},
        "applicability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "geometry_ref", "evidence_state", "evidence_refs", "decided_at", "rationale"],
          "properties": {
            "status": {"enum": ["UNASSESSED", "APPLIES", "DOES_NOT_APPLY", "PARTIAL"]},
            "geometry_ref": {"type": ["string", "null"]},
            "evidence_state": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/evidenceState"}]},
            "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "decided_at": {"type": ["string", "null"], "format": "date-time"},
            "rationale": {"type": "string"}
          }
        },
        "method": {"const": "SPATIAL_APPLICABILITY_ONLY_NO_FACT_VALUE"}
      }
    },
    "blockers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
