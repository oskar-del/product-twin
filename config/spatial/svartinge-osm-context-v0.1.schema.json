{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-twin.local/schemas/spatial/svartinge-osm-context-v0.1.schema.json",
  "title": "Svärtinge source-bound OpenStreetMap context v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entity_type", "context_id", "subject", "source", "transform", "statistics", "compiled", "derived_content_sha256", "evidence_policy"],
  "properties": {
    "schema_version": {"const": "svartinge-osm-context/v0.1"},
    "entity_type": {"const": "SourceBoundNeighbourhoodContext"},
    "context_id": {"const": "SE_SVARTINGE_54_28_OSM_900M_V01"},
    "subject": {"type": "object", "additionalProperties": false, "required": ["working_property_identity", "origin_wgs84", "context_radius_m", "stitching_halo_m", "selection_radius_m"], "properties": {"working_property_identity": {"const": "SVÄRTINGE 54:28"}, "origin_wgs84": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2}, "context_radius_m": {"const": 800}, "stitching_halo_m": {"const": 100}, "selection_radius_m": {"const": 900}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["provider", "service", "endpoint", "state", "official_source", "canonical_query", "retrieved_at", "osm_base_timestamp", "license", "attribution", "copyright_url", "raw_runtime_locator", "raw_byte_count", "raw_sha256", "credentials_required", "credentials_persisted"], "properties": {"provider": {"const": "OpenStreetMap contributors"}, "service": {"const": "Overpass API"}, "endpoint": {"type": "string", "format": "uri"}, "state": {"const": "CONNECTED_SOURCE_SNAPSHOT"}, "official_source": {"const": false}, "canonical_query": {"type": "string", "minLength": 1}, "retrieved_at": {"type": "string", "format": "date-time"}, "osm_base_timestamp": {"type": "string", "format": "date-time"}, "license": {"const": "ODbL-1.0"}, "attribution": {"const": "© OpenStreetMap contributors"}, "copyright_url": {"const": "https://www.openstreetmap.org/copyright"}, "raw_runtime_locator": {"type": "string", "pattern": "^\\.runtime/"}, "raw_byte_count": {"type": "integer", "minimum": 1}, "raw_sha256": {"$ref": "#/$defs/sha256"}, "credentials_required": {"const": false}, "credentials_persisted": {"const": false}}},
    "transform": {"type": "object", "additionalProperties": false, "required": ["frame", "method", "linear_units", "clip_bounds_xz_m", "precision_m", "limitations"], "properties": {"frame": {"const": "LOCAL_EAST_NORTH"}, "method": {"const": "WGS84_LOCAL_EQUIRECTANGULAR_AROUND_MUNICIPAL_LOCATOR"}, "linear_units": {"const": "metre"}, "clip_bounds_xz_m": {"const": [-900, -900, 900, 900]}, "precision_m": {"const": 0.01}, "limitations": {"$ref": "#/$defs/nonEmptyStrings"}}},
    "statistics": {"type": "object", "additionalProperties": false, "required": ["raw_element_count", "road_segment_count", "named_street_count", "named_streets", "building_footprint_count", "landcover_polygon_count", "water_polygon_count", "waterway_segment_count"], "properties": {"raw_element_count": {"type": "integer", "minimum": 1}, "road_segment_count": {"type": "integer", "minimum": 10}, "named_street_count": {"type": "integer", "minimum": 10}, "named_streets": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "building_footprint_count": {"type": "integer", "minimum": 1}, "landcover_polygon_count": {"type": "integer", "minimum": 0}, "water_polygon_count": {"type": "integer", "minimum": 0}, "waterway_segment_count": {"type": "integer", "minimum": 0}}},
    "compiled": {"type": "object", "additionalProperties": false, "required": ["roads", "buildings", "landcover", "water", "waterways"], "properties": {"roads": {"type": "array", "items": {"$ref": "#/$defs/road"}}, "buildings": {"type": "array", "items": {"$ref": "#/$defs/building"}}, "landcover": {"type": "array", "items": {"$ref": "#/$defs/surface"}}, "water": {"type": "array", "items": {"$ref": "#/$defs/surface"}}, "waterways": {"type": "array", "items": {"$ref": "#/$defs/line"}}}},
    "derived_content_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_policy": {"type": "object", "additionalProperties": false, "required": ["evidence_class", "legal_effect", "official_geometry_gates_closed", "market_data_included", "personal_data_included", "required_attribution_visible", "forbidden_claims"], "properties": {"evidence_class": {"const": "DERIVED"}, "legal_effect": {"const": "NONE"}, "official_geometry_gates_closed": {"const": false}, "market_data_included": {"const": false}, "personal_data_included": {"const": false}, "required_attribution_visible": {"const": true}, "forbidden_claims": {"$ref": "#/$defs/nonEmptyStrings"}}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nonEmptyStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "points": {"type": "array", "minItems": 2, "items": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2}},
    "road": {"type": "object", "additionalProperties": false, "required": ["feature_id", "osm_way_id", "name", "highway_class", "surface", "display_width_m", "width_method", "points_xz"], "properties": {"feature_id": {"type": "string"}, "osm_way_id": {"type": "integer"}, "name": {"type": ["string", "null"]}, "highway_class": {"type": "string"}, "surface": {"type": ["string", "null"]}, "display_width_m": {"type": "number", "exclusiveMinimum": 0}, "width_method": {"type": "string"}, "points_xz": {"$ref": "#/$defs/points"}}},
    "building": {"type": "object", "additionalProperties": false, "required": ["feature_id", "osm_way_id", "building_tag", "points_xz", "source_height_m", "source_levels", "display_height_m", "height_method"], "properties": {"feature_id": {"type": "string"}, "osm_way_id": {"type": "integer"}, "building_tag": {"type": "string"}, "points_xz": {"$ref": "#/$defs/points"}, "source_height_m": {"type": "null"}, "source_levels": {"type": "null"}, "display_height_m": {"type": "number", "exclusiveMinimum": 0}, "height_method": {"const": "DETERMINISTIC_PRESENTATION_ONLY_NO_OSM_HEIGHT_OR_LEVEL_TAG"}}},
    "surface": {"type": "object", "required": ["feature_id", "osm_way_id", "points_xz"], "properties": {"feature_id": {"type": "string"}, "osm_way_id": {"type": "integer"}, "points_xz": {"$ref": "#/$defs/points"}}},
    "line": {"type": "object", "required": ["feature_id", "osm_way_id", "points_xz"], "properties": {"feature_id": {"type": "string"}, "osm_way_id": {"type": "integer"}, "points_xz": {"$ref": "#/$defs/points"}}}
  }
}
